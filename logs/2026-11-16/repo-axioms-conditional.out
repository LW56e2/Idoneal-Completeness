Idoneal.idoneal_numbers_completeness_of_noRealZeros : Idoneal.NoRealZeros →
  ∀ (n : ℕ), Idoneal.IsIdoneal n → n ∈ Idoneal.knownIdonealNumbers
@Idoneal.idoneal_numbers_completeness_of_zeroFree : ∀ {T : ℝ},
  T < 19 / 20 →
    (∀ {q : ℕ} [inst : NeZero q] (χ : DirichletCharacter ℂ q) (s : ℂ),
        T < s.re → ¬(χ = 1 ∧ s = 1) → DirichletCharacter.LFunction χ s ≠ 0) →
      ∀ (n : ℕ), Idoneal.IsIdoneal n → n ∈ Idoneal.knownIdonealNumbers
Idoneal.isIdoneal_iff_mem_known_of_noRealZeros : Idoneal.NoRealZeros →
  ∀ (n : ℕ), Idoneal.IsIdoneal n ↔ n ∈ Idoneal.knownIdonealNumbers
@Idoneal.isIdoneal_of_mem_known : ∀ {n : ℕ}, n ∈ Idoneal.knownIdonealNumbers → Idoneal.IsIdoneal n
